  "timeline": [
    {
      "step": 480,
      "commands": [
        {
          "type": "body.detach",
          "id": "pod-right"
        }
      ]
    }
  ],
  "end": {
    "steps": 960
  },
  "probes": [
    {
      "id": "L",
      "path": "ledger.totals.angularMomentum"
    },
    {
      "id": "px",
      "path": "ledger.totals.momentum.x"
    },
    {
      "id": "ke",
      "path": "ledger.totals.energy.kinetic"
    },
    {
      "id": "wHull",
      "path": "bodies[id=hull].angularVelocity"
    },
    {
      "id": "wPod",
      "path": "bodies[id=pod-right].angularVelocity"
    },
    {
      "id": "joints",
      "path": "joints.length"
    }
  ],
  "assertions": [
    {
      "kind": "rangeOver",
      "probe": "wHull",
      "from": 0,
      "to": "end",
      "min": 0.7999999,
      "max": 0.8000001
    },
    {
      "kind": "formula",
      "at": "end",
      "left": "(L@end / 16384) - (L@0 / 16384)",
      "right": "0",
      "tol": 1e-9
    },
    {
      "kind": "formula",
      "at": "end",
      "left": "(px@end / 4096) - (px@0 / 4096)",
      "right": "0",
      "tol": 1e-9
    },
    {
      "kind": "formula",
      "at": "end",
      "left": "(ke@end / 16384)",
      "right": "(ke@0 / 16384)",
      "tol": 1e-9,
      "relative": true
    },
    {
      "kind": "valueAt",
      "probe": "joints",
      "step": 481,
      "equals": 1,
      "tol": 0
    },
    {
      "kind": "ledgerResidual",
      "quantity": "angularMomentum",
      "maxAbs": 0.000016384
    },
    {
      "kind": "event",
      "type": "violation",
      "occurred": false
    }
  ],
  "ui": {
    "lookFor": "The assembly drifts and spins as one rigid body. At t = 2 s the right pod is let go and flies off along its tangent. Try detaching a pod yourself: select it and press Detach in the inspector, or right-click it. The hull's assembly panel shows the new mass and inertia.",
    "overlays": [
