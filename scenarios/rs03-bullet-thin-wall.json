{
  "schema": 2,
  "name": "rs03-bullet-thin-wall",
  "title": "Bullet against a thin wall",
  "description": "RS-03. A 10 g, 1 cm bullet at up to limit.maxSpeed (2,000 m/s) hits a fixed wall limit.minThickness (5 cm) thick. It travels 8 m per step but must never pass through.",
  "profile": "test",
  "seed": 1,
  "parameters": [
    {
      "id": "speed",
      "label": "Bullet speed",
      "unit": "m/s",
      "min": 40,
      "max": 8000,
      "step": 40,
      "default": 8000
    },
    {
      "id": "e",
      "label": "Restitution",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0
    }
  ],
  "world": {
    "bodies": [
      {
        "id": "bullet",
        "shape": {
          "kind": "disc",
          "radius": 0.04
        },
        "mass": 10.24,
        "restitution": {
          "$param": "e"
        },
        "friction": 0,
        "position": {
          "x": -20,
          "y": 0
        },
        "velocity": {
          "x": {
            "$param": "speed"
          },
          "y": 0
        },
        "angle": 0,
        "angularVelocity": 0
      },
      {
        "id": "wall",
        "shape": {
          "kind": "box",
          "width": 0.2,
          "height": 8
        },
        "mass": 1024,
        "fixed": true,
        "restitution": {
          "$param": "e"
        },
        "friction": 0,
        "position": {
          "x": 0,
          "y": 0
        },
        "velocity": {
          "x": 0,
          "y": 0
        },
        "angle": 0,
        "angularVelocity": 0
      }
    ]
  },
  "timeline": [],
  "end": {
    "steps": 240
  },
  "probes": [
    {
      "id": "bx",
      "path": "bodies[id=bullet].position.x"
    },
    {
      "id": "vx",
      "path": "bodies[id=bullet].velocity.x"
    }
  ],
  "assertions": [
    {
      "kind": "rangeOver",
      "probe": "bx",
      "from": 0,
      "to": "end",
      "max": -0.12
    },
    {
      "kind": "formula",
      "at": "end",
      "left": "((vx / 4) + e * (speed / 4)) / (speed / 4)",
      "right": "0",
      "tol": 1e-9
    },
    {
      "kind": "event",
      "type": "collision",
      "occurred": true
    },
    {
      "kind": "event",
      "type": "violation",
      "occurred": false
    }
  ],
  "ui": {
    "lookFor": "Press step (.) a few times. The bullet covers 8 m per step yet stops exactly at the wall's face, because contacts are generated ahead of time (speculative contacts).",
    "overlays": [
      "velocity",
      "contacts"
    ],
    "graphs": [
      "bx",
      "vx"
    ],
    "camera": {
      "x": -10,
      "y": 0,
      "zoom": 20
    }
  }
}
