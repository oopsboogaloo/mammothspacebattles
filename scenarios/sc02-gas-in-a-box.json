    {
      "id": "thermal",
      "path": "gas.thermal"
    },
    {
      "id": "temp",
      "path": "gas.temperature"
    },
    {
      "id": "spread",
      "path": "gas.spread"
    },
    {
      "id": "gasX",
      "path": "gas.centre.x"
    },
    {
      "id": "energy",
      "path": "ledger.totals.energy.total"
    }
  ],
  "assertions": [
    {
      "kind": "rangeOver",
      "probe": "boxVx",
      "from": 0,
      "to": "end",
      "min": -0.0012,
      "max": 0.0012
    },
    {
      "kind": "rangeOver",
      "probe": "boxVy",
      "from": 0,
      "to": "end",
      "min": -0.0012,
      "max": 0.0012
    },
    {
      "kind": "formula",
      "at": "end",
      "left": "(boxPx / 4096) + (gasPx / 4096)",
      "right": "0",
      "tol": 1e-9
    },
    {
      "kind": "formula",
      "at": "end",
      "left": "(boxPy / 4096) + (gasPy / 4096)",
      "right": "0",
      "tol": 1e-9
    },
    {
      "kind": "formula",
      "at": "end",
      "left": "((wall@end / 4096) - (wall@120 / 4096)) / ((240 - 120) / 240 * 8)",
      "right": "0.4 * (thermal@end / 16384) / 4",
      "tol": 0.05,
      "relative": true
    },
    {
      "kind": "rangeOver",
      "probe": "spread",
      "from": 0,
      "to": "end",
      "min": 3.2,
      "max": 3.32
    },
    {
      "kind": "ledgerResidual",
      "quantity": "momentum",
      "maxAbs": 0.000004096
    },
    {
      "kind": "ledgerResidual",
      "quantity": "angularMomentum",
      "maxAbs": 0.000016384
    },
    {
      "kind": "ledgerResidual",
      "quantity": "energy",
      "maxAbs": 0.016384
    },
    {
      "kind": "event",
      "type": "violation",
      "occurred": false
    }
  ],
  "ui": {
    "lookFor": "Box and gas momentum stay equal and opposite. Filled evenly, the box stays still.",
    "overlays": [
      "velocity"
