{
  "name": "mammoth-space-battles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:e2e": "playwright test",
    "req:check": "node scripts/req-trace.ts --milestone M0",
    "req:report": "node scripts/req-trace.ts",
    "sim": "node src/cli/sim.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm req:check",
    "bench": "node scripts/bench.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.1.0",
    "vitest": "4.1.12"
  }
}
